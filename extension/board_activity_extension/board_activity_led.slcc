id: board_activity_led
label: Board Activity LED
package: custom
description: >
  Fixes Gecko SDK bug where halStackIndicateActivity does not work with
  simple_led. Uses linker wrap to override the function.
category: Platform|Driver|LED
quality: production
source:
  - path: src/board_activity_led.c
config_file:
  - path: config/board_activity_led_config.h
    file_id: board_activity_led_config
provides:
  - name: board_activity_led
requires:
  - name: led
toolchain_settings:
  - option: gcc_linker_option
    value: "-Wl,--wrap=halStackIndicateActivity"
  - option: llvm_linker_option
    value: "-Wl,--wrap=halStackIndicateActivity"

metadata:
  nabucasa:
    wrap_definitions:
      # The stack's calls to `halStackIndicateActivity` bypass the wrap under LTO unless the legacy HAL's definition is kept out of it
      halStackIndicateActivity: "base-replacement.c"
