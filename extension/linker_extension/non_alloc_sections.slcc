id: non_alloc_sections
label: Non-alloc Linker Sections
package: custom
description: Places the non-alloc sections that the SDK linker script leaves as orphans, so `--orphan-handling=error` only rejects loadable ones.
category: Platform|Toolchain
quality: production
provides:
  - name: non_alloc_sections
template_file:
  - path: template/non_alloc_sections.ld.jinja
toolchain_settings:
  # Read after the SDK's `linkerfile.ld`
  - option: llvm_linker_option
    value: "-T${CMAKE_CURRENT_LIST_DIR}/../autogen/non_alloc_sections.ld"
