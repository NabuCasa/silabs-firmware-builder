id: zbt2_router_callbacks
label: ZBT-2 Router Callbacks
package: custom
description: Zigbee router callbacks with LED feedback for ZBT-2 hardware
category: Zigbee|Router
quality: production
provides:
  - name: zbt2_router_callbacks
  - name: led_effects
requires:
  - name: ohf_sys_tokens
  - name: ohf_runtime
  - name: led_effects_base
  - name: ws2812_driver
  - name: zigbee_network_steering
  - name: zigbee_find_and_bind_target
  - name: zigbee_identify
  - name: zigbee_on_off
template_contribution:
  - name: ohf_rust_component
    value: zbt2_router_callbacks
  - name: zigbee_af_callback
    value:
      callback_type: event_init
      function_name: zbt2_router_init
  - name: zigbee_stack_callback
    value:
      callback_type: stack_status
      function_name: zbt2_router_stack_status_cb

metadata:
  rust:
    crate:
      path: rust/zbt2_router_callbacks
  link:
    weak_overrides:
      - sl_zigbee_af_color_control_server_compute_pwm_from_temp_cb
      - sl_zigbee_af_color_control_server_compute_pwm_from_xy_cb
      - sl_zigbee_af_identify_start_feedback_cb
      - sl_zigbee_af_identify_stop_feedback_cb
      - sl_zigbee_af_level_control_cluster_server_post_init_cb
      - sl_zigbee_af_network_steering_complete_cb
      - sl_zigbee_af_on_off_cluster_server_post_init_cb
      - sl_zigbee_af_post_attribute_change_cb
