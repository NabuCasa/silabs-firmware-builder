id: zbt2_reset_button
label: ZBT-2 Reset Button
package: custom
description: Pin-hole reset button handler for factory reset with LED feedback
category: Platform|Driver|Button
quality: production
config_file:
  - path: config/zbt2_reset_button_config.h
    file_id: zbt2_reset_button_config
provides:
  - name: zbt2_reset_button
requires:
  - name: ohf_runtime
  - name: led_manager
  - name: simple_button
  - name: sleeptimer
template_contribution:
  - name: ohf_rust_feature
    value: zbt2_reset_button

metadata:
  nabucasa:
    weak_overrides:
      - sl_button_on_change
