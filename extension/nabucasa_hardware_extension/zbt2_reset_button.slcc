id: zbt2_reset_button
label: ZBT-2 Reset Button
package: custom
description: Pin-hole reset button handler for factory reset with LED feedback
category: Platform|Driver|Button
quality: production
provides:
  - name: zbt2_reset_button
requires:
  - name: ohf_sys_factory_erase
  - name: ohf_runtime
  - name: led_manager
  - name: simple_button
  - name: sleeptimer
template_contribution:
  - name: ohf_rust_component
    value: zbt2_reset_button

metadata:
  nabucasa:
    crate:
      path: rust/zbt2_reset_button
      dependencies:
        critical-section: "1"
    weak_overrides:
      - sl_button_on_change
    rust_config:
      # Blink cycles the button must be held for to reset
      ZBT2_RESET_BUTTON_CYCLES: 4
      ZBT2_RESET_BUTTON_CYCLE_DELAY_MS: 500
      ZBT2_RESET_BUTTON_BLINK_ON_MS: 150
      ZBT2_RESET_BUTTON_BLINK_OFF_MS: 50
      # Before the blinks start, after each cycle
      ZBT2_RESET_BUTTON_BLINK_START_DELAY_MS: 200
