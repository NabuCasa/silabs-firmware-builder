id: led_effects_base
label: LED Effects Base
package: custom
description: LED state machine for network status and tilt detection, base implementation
category: Platform|Driver|LED
quality: production
include:
  - path: inc
    file_list:
    - path: led_manager.h
provides:
  - name: led_effects_base
  - name: led_manager
requires:
  - name: ohf_sys
  - name: ohf_runtime
  - name: ws2812_driver
  - name: qma6100p_driver
  - name: sleeptimer
  - name: i2cspm
template_contribution:
  - name: event_handler
    value:
      event: service_process_action
      include: led_manager.h
      handler: led_manager_process_action
  - name: ohf_rust_component
    value: led_effects_base

metadata:
  nabucasa:
    crate:
      path: rust/led_effects_base
