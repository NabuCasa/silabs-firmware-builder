id: qma6100p_driver
label: QMA6100P Accelerometer Driver
package: custom
description: QMA6100P 3-axis accelerometer driver using I2CSPM
category: Platform|Driver|Sensor
quality: production
include:
  - path: inc
    file_list:
    - path: qma6100p.h
provides:
  - name: qma6100p_driver
requires:
  - name: ohf_sys
  - name: ohf_runtime
  - name: i2cspm
template_contribution:
  - name: event_handler
    value:
      event: stack_init
      include: qma6100p.h
      handler: qma6100p_system_init
  - name: component_catalog
    value: qma6100p_driver

metadata:
  rust:
    crate:
      path: rust/qma6100p_driver
