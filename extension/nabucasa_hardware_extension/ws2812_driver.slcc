id: ws2812_driver
label: WS2812 LED Driver
package: custom
description: WS2812 addressable RGB LED driver using SPIDRV
category: Platform|Driver|LED
quality: production
include:
  - path: inc
    file_list:
    - path: ws2812.h
provides:
  - name: ws2812_driver
requires:
  - name: ohf_sys
  - name: ohf_runtime
  - name: spidrv_instance
  - name: emlib_gpio
  - name: simple_rgb_pwm_led_core
template_contribution:
  - name: event_handler
    value:
      event: driver_init
      include: ws2812.h
      handler: ws2812_led_driver_init
  - name: ohf_rust_component
    value: ws2812_driver

metadata:
  nabucasa:
    crate:
      path: rust/ws2812_driver
      dependencies:
        critical-section: "1"
    rust_config:
      WS2812_NUM_LEDS: null
      WS2812_EN_PORT: null
      WS2812_EN_PIN: null
