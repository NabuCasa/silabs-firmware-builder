id: ohf_sys_factory_erase
label: OHF SDK Bindings - Factory Erase
package: custom
description: NVM3 and PSA erase for the Rust components
category: Platform|Rust
quality: production
provides:
  - name: ohf_sys_factory_erase
requires:
  - name: ohf_sys
  - name: nvm3_default
  - name: psa_crypto
template_contribution:
  - name: ohf_rust_component
    value: ohf_sys_factory_erase

metadata:
  rust:
    crate:
      path: rust/ohf-sys
      features: [factory_erase]
