id: ohf_runtime
label: OHF Rust Runtime
package: custom
description: The Rust components' runtime. tools/build_project.py links the enabled components' crates.
category: Platform|Rust
quality: production
provides:
  - name: ohf_runtime
template_file:
  # The enabled Rust components
  - path: ohf_rust_components.json.jinja
template_contribution:
  - name: ohf_rust_component
    value: ohf_runtime

metadata:
  rust:
    crate:
      path: rust/ohf_runtime
