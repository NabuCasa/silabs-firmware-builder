using "platforms/cpus/silabs/efr32s2/efr32mg24.repl"

// EFR32MG24A420F1536IM40: +20 dBm PA only
deviceInformation:
    deviceNumber: 420

radio:
    pa0DbmSupport: true
    pa10DbmSupport: false
    pa20DbmSupport: true

sram:
    size: 0x40000

flash:
    size: 0x17E000

lockbitsdata: Miscellaneous.SiLabs.EFR32xG2_LockbitsData @ sysbus 0x0817E000
    size: 0x2000

msc:
    flashSize: 0x180000
    flashPageSize: 0x2000

