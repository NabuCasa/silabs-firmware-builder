id: router_nvram_reset
label: Router NVRAM Reset
package: custom
description: Resets NVRAM if coordinator data is found, allowing a router to start fresh when previously flashed with coordinator/NCP firmware
category: Zigbee|Router
quality: production
provides:
  - name: router_nvram_reset
requires:
  - name: ohf_runtime
  - name: nvm3_default
  - name: psa_crypto
  - name: token_manager
  - name: zigbee_pro_stack
template_contribution:
  - name: ohf_rust_feature
    value: router_nvram_reset
  - name: zigbee_af_callback
    value:
      callback_type: event_init
      function_name: router_nvram_reset_init
