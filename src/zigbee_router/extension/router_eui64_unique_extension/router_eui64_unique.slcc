id: router_eui64_unique
label: Router EUI64 Unique
package: custom
description: Modifies the router's EUI64 by inverting octets to prevent conflicts when a former coordinator is used as a router
category: Zigbee|Router
quality: production
provides:
  - name: router_eui64_unique
requires:
  - name: ohf_runtime
  - name: token_manager
template_contribution:
  - name: component_catalog
    value: router_eui64_unique
toolchain_settings:
  - option: gcc_linker_option
    value: "-Wl,--wrap=sl_token_manager_get_data"
  - option: llvm_linker_option
    value: "-Wl,--wrap=sl_token_manager_get_data"

metadata:
  rust:
    crate:
      path: rust
  link:
    wrap_definitions:
      sl_token_manager_get_data: "sl_token_manager_api.c"
