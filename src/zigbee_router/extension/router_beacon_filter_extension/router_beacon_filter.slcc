id: router_beacon_filter
label: Router Beacon Filter
package: custom
description: Filters out beacons from problematic networks during network scanning
category: Zigbee|Router
quality: production
provides:
  - name: router_beacon_filter
requires:
  - name: ohf_runtime
  - name: zigbee_pro_stack
template_contribution:
  - name: ohf_rust_component
    value: router_beacon_filter
toolchain_settings:
  - option: gcc_linker_option
    value: "-Wl,--wrap=sli_zigbee_stack_get_stored_beacon"
  - option: llvm_linker_option
    value: "-Wl,--wrap=sli_zigbee_stack_get_stored_beacon"

metadata:
  rust:
    crate:
      path: rust
  link:
    wrap_definitions:
      sli_zigbee_stack_get_stored_beacon: "libzigbee-pro-stack.a:beacon-handling.c.obj"
