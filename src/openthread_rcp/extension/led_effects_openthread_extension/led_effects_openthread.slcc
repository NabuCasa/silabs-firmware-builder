id: led_effects_openthread
label: LED Effects OpenThread
package: custom
description: LED state machine for network status and tilt detection, OpenThread implementation
category: Thread|NCP
quality: production
provides:
  - name: led_effects
requires:
  - name: ohf_sys
  - name: ohf_runtime
  - name: led_effects_base
template_contribution:
  - name: ot_init
    value: led_effects_system_init
  - name: ohf_rust_component
    value: led_effects_openthread

metadata:
  rust:
    crate:
      path: rust
