id: xncp_core
label: XNCP Core
package: custom
description: Extensible NCP command framework
category: Zigbee|NCP
quality: production
provides:
  - name: xncp_core
requires:
  - name: xncp_macros
  - name: ohf_runtime
  - name: zigbee_xncp
template_contribution:
  - name: component_catalog
    value: xncp_core
  # linkme collects the XNCP commands and features into these sections. Put them in
  # flash. Otherwise the linker puts them in RAM, and startup code never fills them.
  - name: rodata_sections
    value: linkme_XNCP_COMMANDS
  - name: rodata_sections
    value: linkme_XNCP_FEATURES
  - name: rodata_sections
    value: linkm2_XNCP_COMMANDS
  - name: rodata_sections
    value: linkm2_XNCP_FEATURES

metadata:
  rust:
    crate:
      path: rust/xncp_core
  link:
    weak_overrides:
      - sl_zigbee_af_xncp_incoming_custom_frame_cb
