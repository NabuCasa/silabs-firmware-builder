id: xncp_core
label: XNCP Core
package: custom
description: Extensible NCP command framework
category: Zigbee|NCP
quality: production
provides:
  - name: xncp_core
requires:
  - name: xncp_macros
  - name: ohf_runtime
  - name: zigbee_xncp
template_contribution:
  - name: ohf_rust_component
    value: xncp_core

metadata:
  rust:
    crate:
      path: rust/xncp_core
  link:
    weak_overrides:
      - sl_zigbee_af_xncp_incoming_custom_frame_cb
