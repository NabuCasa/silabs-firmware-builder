id: xncp_common_commands
label: XNCP Common Commands
package: custom
description: Common XNCP commands for all coordinators
category: Zigbee|NCP
quality: production
provides:
  - name: xncp_common_commands
requires:
  - name: xncp_core
  - name: ohf_runtime
toolchain_settings:
  - option: gcc_linker_option
    value: "-Wl,--wrap=sli_zigbee_am_multicast_member"
  - option: llvm_linker_option
    value: "-Wl,--wrap=sli_zigbee_am_multicast_member"
template_contribution:
  - name: component_catalog
    value: xncp_common_commands
  - name: zigbee_stack_callback
    priority: -9999
    value:
      callback_type: override_append_source_route
      function_name: nc_zigbee_override_append_source_route

metadata:
  rust:
    crate:
      path: rust
    config:
      XNCP_MANUAL_SOURCE_ROUTE_TABLE_SIZE: { type: usize, default: 200 }
      XNCP_MFG_MANUF_NAME: { type: bytes, default: "" }
      XNCP_MFG_BOARD_NAME: { type: bytes, default: "" }
      XNCP_BUILD_STRING: { type: bytes, default: "" }
      # Override only if external flow control differs from the UART's (e.g. ZBT-2)
      XNCP_FLOW_CONTROL_TYPE: { type: u32, default: OHF_VCOM_FLOW_CONTROL_TYPE }
      # The EZSP version's special number, 0xFF keeps the stack's
      XNCP_EZSP_VERSION_PATCH_NUM_OVERRIDE: { type: u8, default: 0xFF }
      # For countries without an explicit entry
      XNCP_DEFAULT_RECOMMENDED_TX_POWER_DBM: { type: i8, default: 8 }
      XNCP_DEFAULT_MAX_TX_POWER_DBM: { type: i8, default: 8 }
