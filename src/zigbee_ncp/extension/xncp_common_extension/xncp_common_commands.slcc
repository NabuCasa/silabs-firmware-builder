id: xncp_common_commands
label: XNCP Common Commands
package: custom
description: Common XNCP commands for all coordinators
category: Zigbee|NCP
quality: production
provides:
  - name: xncp_common_commands
requires:
  - name: xncp_core
  - name: ohf_runtime
toolchain_settings:
  - option: gcc_linker_option
    value: "-Wl,--wrap=sli_zigbee_am_multicast_member"
  - option: llvm_linker_option
    value: "-Wl,--wrap=sli_zigbee_am_multicast_member"
template_contribution:
  - name: ohf_rust_component
    value: xncp_common_commands
  - name: zigbee_stack_callback
    priority: -9999
    value:
      callback_type: override_append_source_route
      function_name: nc_zigbee_override_append_source_route

metadata:
  nabucasa:
    crate:
      path: rust
    rust_config:
      XNCP_MANUAL_SOURCE_ROUTE_TABLE_SIZE: 200
      XNCP_MFG_MANUF_NAME: ""
      XNCP_MFG_BOARD_NAME: ""
      XNCP_BUILD_STRING: ""
      # Override only if external flow control differs from the UART's (e.g. ZBT-2)
      XNCP_FLOW_CONTROL_TYPE: OHF_VCOM_FLOW_CONTROL_TYPE
      # The EZSP version's special number, 0xFF keeps the stack's
      XNCP_EZSP_VERSION_PATCH_NUM_OVERRIDE: 0xFF
      # For countries without an explicit entry
      XNCP_DEFAULT_RECOMMENDED_TX_POWER_DBM: 8
      XNCP_DEFAULT_MAX_TX_POWER_DBM: 8
