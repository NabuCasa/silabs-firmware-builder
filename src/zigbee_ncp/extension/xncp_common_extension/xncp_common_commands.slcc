id: xncp_common_commands
label: XNCP Common Commands
package: custom
description: Common XNCP commands for all coordinators
category: Zigbee|NCP
quality: production
source:
  - path: src/xncp_common_commands.c
  - path: src/tx_power.c
  - path: src/ezsp_version.c
include:
  - path: inc
    file_list:
    - path: xncp_common_commands.h
    - path: tx_power.h
config_file:
  - path: config/xncp_config.h
    file_id: xncp_config
provides:
  - name: xncp_common_commands
requires:
  - name: xncp_core
toolchain_settings:
  - option: gcc_linker_option
    value: "-Wl,--wrap=sli_zigbee_am_multicast_member"
  - option: llvm_linker_option
    value: "-Wl,--wrap=sli_zigbee_am_multicast_member"
template_contribution:
  # The command table (xncp_common_commands[]) and feature bits are now consumed by the
  # Rust XNCP core (crates/ohf-xncp) via an extern bridge + XNCP_COMMON_FEATURES, until
  # this set is itself ported. Only the stack callbacks remain contributions.
  - name: zigbee_af_callback
    value:
      callback_type: event_init
      function_name: xncp_common_init
  - name: zigbee_stack_callback
    priority: -9999
    value:
      callback_type: override_append_source_route
      function_name: nc_zigbee_override_append_source_route
