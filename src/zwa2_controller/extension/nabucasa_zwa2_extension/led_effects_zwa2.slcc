id: led_effects_zwa2
label: LED Effects (ZWA-2)
package: custom
description: LED state machine for host connection status and tilt detection, ZWA-2 implementation
category: Platform|Driver|LED
quality: production
include:
  - path: inc
    file_list:
    - path: led_effects_zwa2.h
provides:
  - name: led_effects_zwa2
requires:
  - name: ohf_sys
  - name: ohf_runtime
  - name: ws2812_driver
  - name: qma6100p_driver
  - name: sleeptimer
template_contribution:
  - name: component_catalog
    value: led_effects_zwa2

metadata:
  rust:
    crate:
      path: rust/led_effects_zwa2
