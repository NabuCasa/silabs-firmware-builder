id: bootloader_slot_install
label: Storage Slot Install
package: custom
description: >
  Adapts the stock bootloader to a storage slot. It erases the file in storage slot 0
  once it is installed, because the stock bootloader installs any valid file in the
  slot whenever it is entered. It also clears the SDK's reset counter when the XMODEM
  menu is left with "run", because every entry with an empty slot counts towards the
  SDK's reset-loop stop.
category: Platform|Bootloader|Storage
quality: production
source:
  - path: src/btl_slot_install.c
provides:
  - name: bootloader_slot_install
requires:
  - name: bootloader_internal_storage
  - name: bootloader_storage_slots
  - name: bootloader_common_storage
toolchain_settings:
  - option: gcc_linker_option
    value: "-Wl,--wrap=storage_main"
  - option: gcc_linker_option
    value: "-Wl,--wrap=reset_resetWithReason"
  - option: llvm_linker_option
    value: "-Wl,--wrap=storage_main"
  - option: llvm_linker_option
    value: "-Wl,--wrap=reset_resetWithReason"
